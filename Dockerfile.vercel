FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY pom.xml .
COPY src ./src
RUN mvn -B -DskipTests package

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=build /workspace/target/core-bancario-simplificado.jar /app/app.jar
ENV PORT=80
EXPOSE 80
CMD ["sh", "-c", "DB_HOST=\"${DATABASE_POSTGRES_HOST:-${DATABASE_PGHOST:-${PGHOST:-}}}\"; DB_NAME=\"${DATABASE_POSTGRES_DATABASE:-${DATABASE_PGDATABASE:-${PGDATABASE:-}}}\"; DB_USER=\"${DATABASE_POSTGRES_USER:-${DATABASE_PGUSER:-${PGUSER:-}}}\"; DB_PASSWORD=\"${DATABASE_POSTGRES_PASSWORD:-${DATABASE_PGPASSWORD:-${PGPASSWORD:-}}}\"; DB_PORT=\"${DATABASE_POSTGRES_PORT:-${DATABASE_PGPORT:-${PGPORT:-5432}}}\"; if [ -n \"$DB_HOST\" ] && [ -n \"$DB_NAME\" ]; then export SPRING_DATASOURCE_URL=\"jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require\"; fi; if [ -n \"$DB_USER\" ]; then export SPRING_DATASOURCE_USERNAME=\"$DB_USER\"; fi; if [ -n \"$DB_PASSWORD\" ]; then export SPRING_DATASOURCE_PASSWORD=\"$DB_PASSWORD\"; fi; exec java -jar /app/app.jar --server.port=\"${PORT:-8080}\" --spring.main.lazy-initialization=true --spring.jpa.show-sql=false --logging.level.org.hibernate.SQL=INFO"]
